+
+static long zl_filesize(const char *_path)
+{
+	_DTA dta;
+	_DTA *old = (_DTA*)Fgetdta();
+	Fsetdta(&dta);
+	long r = Fsfirst(_path, 0x07);
+	Fsetdta(old);
+	return (r == 0) ? (long)dta.dta_size : -1;
+}
+
+// move the physical handle to the logical position before a transfer
+static int zl_sync(zl_file *_f)
+{
+	if (_f->vpos == _f->pos)
+		return 0;
+
+	if (_f->vpos < _f->pos)
+	{
+		// backwards: reopen (read-only streams only) and start from 0
+		if (!_f->readonly)
+			return -1;
+		Fclose(_f->handle);
+		short h = (short)Fopen(_f->path, S_READ);
+		if (h < 0)
+		{
+			_f->handle = -1;
+			return -1;
+		}
+		_f->handle = h;
+		_f->pos = 0;
+	}
+
+	// forwards: skip by reading
+	char skip[256];
+	while (_f->pos < _f->vpos)
+	{
+		long n = _f->vpos - _f->pos;
+		if (n > (long)sizeof(skip)) n = sizeof(skip);
+		long r = Fread(_f->handle, n, skip);
+		if (r <= 0)
+			return -1;
+		_f->pos += r;
+	}
+	return 0;
