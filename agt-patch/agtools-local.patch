+// [wof] memory bundle: read-only files served from a block in RAM, so a set of files costs one disk read instead
+// of one open + read each (seconds per file from a floppy). The game loads the block and sets the pointer.
+// Layout: u16 count, then count x { char name[12] (upper case, NUL padded), u32 offset from the block start,
+// u32 size }, then the data.
+const unsigned char *g_zl_bundle = 0;
+
+static const unsigned char *zl_bundle_find(const char *_name, long *_size)
+{
+	if (!g_zl_bundle)
+		return 0;
+	const char *base = _name;
+	for (const char *q = _name; *q; q++)
+		if (*q == '\\' || *q == '/' || *q == ':') base = q + 1;
+	int n = (g_zl_bundle[0] << 8) | g_zl_bundle[1];
+	const unsigned char *e = g_zl_bundle + 2;
+	for (int i = 0; i < n; i++, e += 20)
+	{
+		int k = 0;
+		for (; k < 12; k++)
+		{
+			char a = base[k], b = (char)e[k];
+			if (a >= 'a' && a <= 'z') a -= 32;
+			if (a != b) break;
+			if (!a) { k = 12; break; }
+		}
+		if (k == 12 && (e[11] == 0 || base[12] == 0))
+		{
+			*_size = ((long)e[16] << 24) | ((long)e[17] << 16) | ((long)e[18] << 8) | e[19];
+			return g_zl_bundle + (((long)e[12] << 24) | ((long)e[13] << 16) | ((long)e[14] << 8) | e[15]);
+		}
+	}
+	return 0;
+}
+
