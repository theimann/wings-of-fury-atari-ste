+//	On normal drives Fseek works and nothing changes.
+// ----------------------------------------------------------------------------------------
+
+struct zl_file
+{
+	short handle;		// GEMDOS handle, -1 = slot free
+	short readonly;
+	long pos;			// physical position of the GEMDOS handle (as far as we know)
+	long vpos;			// logical position requested by the caller
+	long size;			// file size from Fsfirst at open time, -1 = unknown
+	const unsigned char *mem;	// [wof] file served from the memory bundle (0 = from disk)
+	char path[128];
+};
